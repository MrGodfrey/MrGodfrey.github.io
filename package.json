{
  "name": "mrgodfrey-github-io",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/tailwind.css -o ./assets/site.css --minify",
    "build:math": "node scripts/copy-mathjax.cjs",
    "build:cv": "uv run python generate_cv.py",
    "build": "npm run build:math && npm run build:css && uv run python generate.py",
    "deploy": "node scripts/publish.cjs",
    "test:publish": "node --test tests/publish.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "mathjax": "4.1.3",
    "tailwindcss": "^3.4.17"
  }
}
